# -----------------------------------------------------------------------------
# Secrets for the Edge Functions (e.g. the notification dispatcher).
# Local development: `npm run dispatch:setup` creates supabase/functions/.env for you.
# Production: set these with `npx supabase secrets set NAME=value` (never commit real values).
# -----------------------------------------------------------------------------

# Shared secret that Supabase Cron sends in the x-dispatch-secret header. The same value is stored
# in the database Vault (name: dispatch_secret) so the scheduled job can send it.
DISPATCH_SECRET=

# Public address of the web app, used for links inside emails.
APP_URL=http://localhost:3000

# Email provider (Resend). Without RESEND_API_KEY every message is only logged, never emailed.
# Create the key at resend.com/api-keys with "Sending access" only.
# RESEND_API_KEY=re_...
#
# Sender address. It must be on a domain verified in Resend (resend.com/domains). Until you have
# one, use onboarding@resend.dev: Resend then delivers ONLY to the address you signed up to
# Resend with, so make that the test address (Admin -> Settings). The sender NAME is a setting.
# EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Signing secret of the Resend webhook (whsec_...), shown on the webhook's page in Resend. The
# resend-webhook function refuses every delivery report it cannot verify with it.
# Local development: `npm run dispatch:setup` puts a placeholder here, so the tests can sign
# requests; replace it with the real one to receive reports from Resend (see README).
# RESEND_WEBHOOK_SECRET=whsec_...

# Real recipients are used only if this is exactly "true" AND an administrator has set
# notifications to "live" AND an email provider is configured. Set it in PRODUCTION ONLY.
# Leave it unset everywhere else.
# NOTIFICATIONS_LIVE=true
