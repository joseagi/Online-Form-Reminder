{
  "name": "office-reminders",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "e2e": "playwright test",
    "functions:check": "deno check --config supabase/functions/dispatch-notifications/deno.json supabase/functions/dispatch-notifications/index.ts && deno check --config supabase/functions/summary-preview/deno.json supabase/functions/summary-preview/index.ts && deno check --config supabase/functions/resend-webhook/deno.json supabase/functions/resend-webhook/index.ts",
    "dispatch:setup": "node --env-file=.env.local scripts/setup-local-dispatch.mjs",
    "webhook:forward": "node scripts/forward-webhooks.mjs",
    "db:start": "supabase start -x studio",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up --local",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "deno": "2.9.6",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
