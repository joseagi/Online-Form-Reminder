# -----------------------------------------------------------------------------
# Environment template for the web app (Next.js).
# Local development: copy to .env.local  ->  Copy-Item .env.example .env.local
# NEVER commit real values. All .env* files are git-ignored except this template.
# -----------------------------------------------------------------------------

# Supabase project URL. The local stack (`npx supabase start`) prints it,
# normally http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe in the browser: Row Level Security applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). SERVER-ONLY: it bypasses Row Level Security.
# Never prefix it with NEXT_PUBLIC_ and never import it from client components.
# Used only by the admin "invite staff" server action.
SUPABASE_SECRET_KEY=

# Public base URL of this app (auth redirect links, links inside emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notification secrets (Resend API key, dispatch secret, NOTIFICATIONS_LIVE) do NOT go here.
# They are Supabase Edge Function secrets with their own template, added with the dispatcher (Phase 4).
